{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "YOUR-TaskDefinition-Name",
    "containerDefinitions": [
        {
            "name": "YOUR-APP-NAME",
            "image": "YOUR-AWS-ACCOUNT-ID.dkr.ecr.YOUR-AWS-REGION.amazonaws.com/YOUR-APP-NAME:#APP_VERSION#",
            "portMappings": [
                {
                    "name": "ngnix-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::YOUR-AWS-ACCOUNT-ID:role/ecsTaskExecutionRole"
}
